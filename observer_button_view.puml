@startuml
title Observer Pattern — "Return" button: AnalyzeViewModel (subject) notifies AnalyzeView (observer)

skinparam backgroundColor White
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #86C5F0
  BorderColor #000000
  FontColor #000000
  ArrowColor #000000
  StereotypeFontColor #000000
}
hide circle

interface PropertyChangeListener <<Interface>> {
  + propertyChange(PropertyChangeEvent)
}

class PropertyChangeSupport {
  + firePropertyChange(propertyName: String, oldValue: Object, newValue: Object)
}

class AnalyzeView {
  - controller: AnalyzeController
  --
  + propertyChange(PropertyChangeEvent)
  - getReturnButton(): JButton
}

class AnalyzeViewModel {
  - support: PropertyChangeSupport
  - messageHistory: List<String>
  --
  + addPropertyChangeListener(propertyName: String, listener: PropertyChangeListener)
  + setRecentMessage()
}

PropertyChangeSupport "1" o-left- "*" PropertyChangeListener
AnalyzeView .up.|> PropertyChangeListener
AnalyzeViewModel *-up- PropertyChangeSupport
AnalyzeView .right.> AnalyzeViewModel : subscribes\n(addPropertyChangeListener)

note top of PropertyChangeSupport
  Calls propertyChange
  on each registered listener
end note

note bottom of AnalyzeView
  "Return" button click →
  controller.executeSingleMessageDisplay()
  ...eventually → viewModel.setRecentMessage()
end note

note bottom of AnalyzeViewModel
  setRecentMessage():
  support.firePropertyChange(
     "analysis", null, recentMessage )
end note
@enduml
