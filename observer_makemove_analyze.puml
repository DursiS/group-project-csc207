@startuml
title Observer Pattern — MakeMoveInteractor (subject) notifies AnalyzeMoveInteractor (observer)

skinparam backgroundColor White
skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam class {
  BackgroundColor #86C5F0
  BorderColor #000000
  FontColor #000000
  ArrowColor #000000
  StereotypeFontColor #000000
}
hide circle

interface PropertyChangeListener <<Interface>> {
  + propertyChange(PropertyChangeEvent)
}

class PropertyChangeSupport {
  + firePropertyChange(propertyName: String, oldValue: Object, newValue: Object)
}

class AnalyzeMoveInteractor {
  + propertyChange(PropertyChangeEvent)
}

class GameState {
}

class MakeMoveInteractor {
  - support: PropertyChangeSupport
  - gameState: GameState
  --
  + addPropertyChangeListener(PropertyChangeListener)
  + receiveInput(MoveInputData)
  - updateAnalyzeMoveInteractor()
}

PropertyChangeSupport "1" o-left- "*" PropertyChangeListener
AnalyzeMoveInteractor .up.|> PropertyChangeListener
MakeMoveInteractor *-up- PropertyChangeSupport
MakeMoveInteractor *-left- GameState
AnalyzeMoveInteractor .right.> GameState

note top of PropertyChangeSupport
  Calls propertyChange
  on each registered listener
end note

note bottom of MakeMoveInteractor
  updateAnalyzeMoveInteractor():
  support.firePropertyChange(
     "update-analysis", null, gameState )
end note
@enduml
